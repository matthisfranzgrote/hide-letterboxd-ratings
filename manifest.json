{
    "manifest_version": 3,
    "name": "Hide Letterboxd Ratings",
    "version": "1.1",
    "description": "Hides the rating curve and reviews on Letterboxd film pages to help avoid spoilers and expectations.",
    "action": {
        "default_title": "Hide Letterboxd Ratings",
        "default_icon": {
            "16": "images/icon_16_blur.png",
            "32": "images/icon_32_blur.png",
            "48": "images/icon_48_blur.png",
            "128": "images/icon_128_blur.png"
        },
        "default_popup": "popup/popup.html"
    },
    "icons": {
        "16": "images/icon_16_blur.png",
        "32": "images/icon_32_blur.png",
        "48": "images/icon_48_blur.png",
        "128": "images/icon_128_blur.png"
    },
    "host_permissions": ["*://*.letterboxd.com/*"],
    "permissions": ["storage", "activeTab", "scripting"],
    "content_scripts": [
        {
            "matches": ["*://*.letterboxd.com/film/*"],
            "exclude_globs": [
                "*/film/*/members/*",
                "*/film/*/fans/*",
                "*/film/*/likes/*",
                "*/film/*/reviews/*",
                "*/film/*/lists/*"
            ],
            "js": ["content.js"],
            "css": ["styles.css"],
            "run_at": "document_end"
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "hide-letterboxed-ratings@matthisfranzgrote",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    }
}
